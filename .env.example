# Garuda core environment. Copy to .env (never commit .env).

# Phoenix Flight builder code. Placeholder only: builder codes apply to REAL routed orders in Phase 2.
# Phase 1 is simulation only, so nothing reads this value except the /health "configured" flag.
PHOENIX_BUILDER_CODE=
PHOENIX_API_URL=https://perp-api.phoenix.trade
PHOENIX_RPC_URL=https://api.mainnet-beta.solana.com

PORT=3000

# Postgres. docker compose up -d db, then:
DATABASE_URL=postgres://garuda:garuda@localhost:5432/garuda
# Leave DATABASE_URL empty to run on the in-memory store (state is lost on restart; dev only).

# Wallet sign-in is ON by default. GARUDA_AUTH=off opens every route to anyone (local dev only, never deploy).
# GARUDA_AUTH=off
# Shown to the user in the sign-in message their wallet displays.
GARUDA_AUTH_DOMAIN=garuda
# Set to 1 only behind a trusted reverse proxy, so per-IP rate limits use X-Forwarded-For.
GARUDA_TRUST_PROXY=

# Risk worker: poll period for Phoenix books of symbols that have exposure, and the stale-feed kill switch.
GARUDA_POLL_MS=1000
GARUDA_STALE_FEED_MS=10000
# GARUDA_WORKER=off runs the API without the worker (no between-tick breach detection).

# Test only: run the Postgres-backed tests on a real database instead of pg-mem.
#   GARUDA_TEST_PG=embedded                      (downloads nothing: uses the embedded-postgres devDependency)
#   GARUDA_TEST_DATABASE_URL=postgres://garuda:garuda@localhost:5432/postgres

# M3/M4: knight NFTs and USDC checkout on Solana DEVNET (never mainnet: mainnet RPC URLs are refused).
# Run `pnpm chain:setup` once; it prints the collection and mint values. Leave GARUDA_CHAIN empty for stub payments.
GARUDA_CHAIN=
GARUDA_SOLANA_RPC_URL=https://api.devnet.solana.com
# Platform key: update authority, treasury, fee payer. Gitignored (.keys/). Never commit it.
GARUDA_KEYPAIR_PATH=.keys/platform.json
GARUDA_KNIGHT_COLLECTION=
GARUDA_USDC_MINT=
# Base URL written into the knight metadata URIs (the API serves /nft/*). Must be reachable by wallets.
GARUDA_PUBLIC_URL=http://localhost:3000
# GARUDA_ART_DIR=art/knights
# GARUDA_RECONCILE_MS=30000
# GARUDA_CHAIN_ALLOW_LOCAL=1   (local validator dry runs only)

# Web app (M5): browser origins allowed to call the API, comma separated, or * for any (read-only public data + bearer auth).
# Not needed with the Vite dev proxy or a same-origin reverse proxy.
# GARUDA_CORS_ORIGIN=http://localhost:5173

# Sign-in with Privy (email or wallet; an embedded Solana wallet is created on first email login). Optional: unset means
# wallet-signature sign-in only. Get the app id and secret from the Privy dashboard (Settings > Basics, App secrets), enable
# Email and Solana wallets in Login methods and Embedded wallets > Solana, and add the web origin to Allowed origins.
# No keys ship with this repo. Set BOTH PRIVY_* values or neither (the worker refuses to start with only one).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Web build (packages/web, read by Vite): the SAME app id as PRIVY_APP_ID. Never put the secret in a VITE_ variable.
VITE_PRIVY_APP_ID=

# M8 payouts (devnet): the treasury (platform key) sends USDC to the funded trader's wallet.
# Trader share of profit (0 < split <= 1, default 0.8 per rules.md section 11). The minimum payout is fixed at $20.
# GARUDA_PAYOUT_SPLIT=0.8
# Payouts up to this many USD are sent automatically; larger ones wait for an admin to approve (default 500).
# GARUDA_PAYOUT_AUTO_MAX=500
# treasury-key (default, devnet hot key). "squads" (multisig proposals) is a stub and is refused at startup.
# GARUDA_PAYOUT_EXECUTOR=treasury-key
# Bearer token for /admin/payouts (approve, reject, retry). At least 24 chars: openssl rand -hex 32. Unset = admin API off (404).
GARUDA_ADMIN_TOKEN=

# Phase 2 Phoenix order routing (packages/router, runbook: docs/phoenix-routing.md). OFF unless ROUTING_ENABLED=true.
# Once enabled it runs DRY (logs only) until ROUTING_DRY_RUN=false AND the delegate key + firm authority are set.
# ROUTING_ENABLED=
# ROUTING_DRY_RUN=true
# PHOENIX_FIRM_AUTHORITY=
# PHOENIX_DELEGATE_KEYPAIR=        (secret: solana-keygen JSON array of the trade-only delegate; never the owner key)
# PHOENIX_TRADE_RPC_URL=           (paid mainnet RPC for sending)
# PHOENIX_BUILDER_AUTHORITY=       (optional Flight builder)
# ROUTING_SIZE_MULTIPLIER=0.1
# ROUTING_MAX_TRADE_NOTIONAL_USD=500
# ROUTING_MAX_TRADER_NOTIONAL_USD=1000
# ROUTING_MAX_TOTAL_NOTIONAL_USD=5000
# ROUTING_DAILY_LOSS_LIMIT_USD=250
# ROUTING_MARKETS=SOL,BTC,ETH
# ROUTING_MAX_SLIPPAGE_BPS=50

# Garuda Beta Access (/early), docs/early-mint.md. Waitlist only unless EARLY_MINT_ENABLED=true (Solana MAINNET).
EARLY_MINT_ENABLED=
EARLY_RPC_URL=
EARLY_MINT_KEYPAIR=
EARLY_COLLECTION=
EARLY_MINT_TREASURY=CCezKqU697kanduvFk8GPwD484DGtKH46tfV9o7T2xKq
EARLY_PRICE_USD=1.69
EARLY_SOULBOUND=true
