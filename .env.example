# Garuda core environment. Copy to .env (never commit .env).

# Phoenix Flight builder code. Placeholder only: builder codes apply to REAL routed orders in Phase 2.
# Phase 1 is simulation only, so nothing reads this value except the /health "configured" flag.
PHOENIX_BUILDER_CODE=
PHOENIX_API_URL=https://perp-api.phoenix.trade
PHOENIX_RPC_URL=https://api.mainnet-beta.solana.com

PORT=3000

# Postgres. docker compose up -d db, then:
DATABASE_URL=postgres://garuda:garuda@localhost:5432/garuda
# Leave DATABASE_URL empty to run on the in-memory store (state is lost on restart; dev only).

# Wallet sign-in is ON by default. GARUDA_AUTH=off opens every route to anyone (local dev only, never deploy).
# GARUDA_AUTH=off
# Shown to the user in the sign-in message their wallet displays.
GARUDA_AUTH_DOMAIN=garuda
# Set to 1 only behind a trusted reverse proxy, so per-IP rate limits use X-Forwarded-For.
GARUDA_TRUST_PROXY=

# Risk worker: poll period for Phoenix books of symbols that have exposure, and the stale-feed kill switch.
GARUDA_POLL_MS=1000
GARUDA_STALE_FEED_MS=10000
# GARUDA_WORKER=off runs the API without the worker (no between-tick breach detection).

# Test only: run the Postgres-backed tests on a real database instead of pg-mem.
#   GARUDA_TEST_PG=embedded                      (downloads nothing: uses the embedded-postgres devDependency)
#   GARUDA_TEST_DATABASE_URL=postgres://garuda:garuda@localhost:5432/postgres
