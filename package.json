{
  "name": "garuda-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Garuda core: simulated matching engine, risk engine and challenge API on Phoenix Perps market data",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @garuda/web typecheck",
    "demo": "tsx scripts/demo.ts",
    "demo:mock": "GARUDA_DEMO_MOCK=1 tsx scripts/demo.ts",
    "api": "tsx packages/worker/src/server.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "db:up": "docker compose up -d db",
    "test:pg": "GARUDA_TEST_PG=embedded vitest run",
    "chain:setup": "tsx scripts/chain-setup.ts",
    "chain:faucet": "tsx scripts/chain-mint-test-usdc.ts",
    "test:chain:local": "LOCAL_VALIDATOR=1 vitest run packages/api/test/e2e-chain.test.ts",
    "test:chain:devnet": "DEVNET=1 vitest run packages/api/test/e2e-chain.test.ts",
    "web:dev": "pnpm --filter @garuda/web dev",
    "web:build": "pnpm --filter @garuda/web build",
    "web:stub": "tsx scripts/web-stub-server.ts",
    "web:screens": "tsx scripts/web-screens.ts"
  },
  "devDependencies": {
    "@garuda/api": "workspace:*",
    "@garuda/db": "workspace:*",
    "@garuda/market-data": "workspace:*",
    "@garuda/risk-engine": "workspace:*",
    "@garuda/sim-engine": "workspace:*",
    "@garuda/worker": "workspace:*",
    "@types/node": "^20.17.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@garuda/chain": "workspace:*"
  }
}
